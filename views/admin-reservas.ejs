<%- include('cabecera') %>
<h1>Todas las reservas</h1>
<table>
  <thead><tr><th>Id</th><th>Usuario</th><th>Equipo</th><th>Fecha</th><th>Turno</th><th>Estado</th><th></th></tr></thead>
  <tbody>
    <% reservas.forEach((r) => { %>
      <tr>
        <td><%= r.id %></td>
        <td><%= r.usuarioNombre %></td>
        <td><%= r.equipoNombre %></td>
        <td><%= r.fecha %></td>
        <td><%= etiquetaTurno(r.turno) %></td>
        <td><%= etiquetaEstado(r.estado) %></td>
        <td>
          <% if (r.estado === 'activa') { %>
            <form method="post" action="/admin/reservas/<%= r.id %>/cancelar" class="en-linea">
              <%- include('csrf') %>
              <button type="submit">Cancelar</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('pie') %>
